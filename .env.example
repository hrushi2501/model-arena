# Copy to .env for local Compose use. Replace the local-only example password.
POSTGRES_USER=model_arena
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=model_arena
RABBITMQ_USER=model_arena
RABBITMQ_PASSWORD=change-this-rabbitmq-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Configure after the backend API and MLflow deployment are implemented.
MODEL_ARENA_API_URL=http://localhost:8080
MLFLOW_TRACKING_URI=http://localhost:5000
CHAMPION_MODEL_URI=
CANDIDATE_MODEL_URI=
