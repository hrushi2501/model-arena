# Copy to .env and supply local credentials. Keep .env out of Git.
POSTGRES_USER=model_arena
POSTGRES_PASSWORD=
POSTGRES_DB=model_arena
RABBITMQ_USER=model_arena
RABBITMQ_PASSWORD=

# Training writes the actual registered URIs to backend/ml/models/versions.env.
CHAMPION_MODEL_URI=models:/wine-classifier/1
CANDIDATE_MODEL_URI=models:/wine-classifier/2
MLFLOW_TRACKING_URI=http://localhost:5001
MODEL_ARENA_API_URL=http://localhost:8080
ENABLE_DEMO_FAULTS=false
